# Neon Postgres — SERVER-ONLY credentials.
#
# `neon init` writes the real values to .env.local (git-ignored). These keys
# must never be given a VITE_ prefix: Vite inlines every VITE_* variable into
# the browser bundle, which would publish the database password to anyone who
# opens the app. The client talks to the database through an API route instead.
#
# Copy the values from .env.local, or re-run:
#   neon init -y --org-id <org-id> --project-id <project-id>
#   npm run db:check          # from GZS-Trading-Journal-Tools

DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
